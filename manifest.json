{
  "schemaVersion": 1,
  "id": "jesusarchive.keyboard-layout-switcher",
  "name": "Keyboard Layout Switcher",
  "version": "0.1.0",
  "author": "jesusarchive",
  "license": "MIT",
  "description": "Show and switch keyboard layouts from the Omarchy bar.",
  "kinds": ["bar-widget", "service"],
  "entryPoints": {
    "barWidget": "Widget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Keyboard Layout Switcher",
    "description": "Shows the active layout and opens a layout menu.",
    "category": "Compositor",
    "aliases": ["keyboard", "input", "language", "layout", "input-source"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barAppearance": "icon",
      "showSourceName": false,
      "showEmojiAndSymbols": true,
      "showKeyboardViewer": true,
      "showSourceNameMenuItem": true,
      "showKeyboardSettings": true
    },
    "schema": [
      { "key": "barAppearance", "type": "enum", "label": "Bar Appearance", "options": ["icon", "bordered", "text"], "defaultValue": "icon", "description": "Choose a filled badge, an outlined badge, or plain text." },
      { "key": "showSourceName", "type": "boolean", "label": "Show Input Source Name in Bar", "defaultValue": false, "description": "Show the full layout name beside the layout indicator." },
      { "key": "showEmojiAndSymbols", "type": "boolean", "label": "Show Emoji & Symbols in Menu", "defaultValue": true },
      { "key": "showKeyboardViewer", "type": "boolean", "label": "Show Keyboard Viewer in Menu", "defaultValue": true },
      { "key": "showSourceNameMenuItem", "type": "boolean", "label": "Show Input Source Name in Menu", "defaultValue": true },
      { "key": "showKeyboardSettings", "type": "boolean", "label": "Show Keyboard Settings in Menu", "defaultValue": true }
    ]
  }
}
