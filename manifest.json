{
  "schemaVersion": 1,
  "id": "jesusarchive.language-switcher",
  "name": "Language Switcher",
  "version": "0.1.0",
  "author": "jesusarchive",
  "license": "MIT",
  "description": "Input source menu and switcher for the Omarchy bar, with Ctrl+Space to go back to the last source.",
  "kinds": ["bar-widget", "service"],
  "entryPoints": {
    "barWidget": "Widget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Language Switcher",
    "description": "Shows the active keyboard layout as an input source icon. Click for the Input menu, or bind Ctrl+Space to go back to the last source.",
    "category": "Compositor",
    "aliases": ["keyboard", "input", "language", "layout", "input-source"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showSourceName": false,
      "showSwitcher": true,
      "hudTimeoutMs": 900,
      "hideWhenSingle": false
    },
    "schema": [
      { "key": "showSourceName", "type": "boolean", "label": "Show input source name", "defaultValue": false, "description": "Show the layout name next to the icon in the bar." },
      { "key": "showSwitcher", "type": "boolean", "label": "Show switcher on Ctrl+Space", "defaultValue": true },
      { "key": "hudTimeoutMs", "type": "integer", "label": "Switcher timeout (ms)", "min": 300, "max": 5000, "step": 100, "defaultValue": 900 },
      { "key": "hideWhenSingle", "type": "boolean", "label": "Hide with a single layout", "defaultValue": false }
    ]
  }
}
